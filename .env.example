# Meridian local development environment.
# Copy to .env and adjust. Never commit .env.

# Runtime
MERIDIAN_ENV=dev
MERIDIAN_LOG_LEVEL=info

# Postgres + TimescaleDB (note non-default port 5433 to avoid conflicts)
MERIDIAN_POSTGRES_DSN=postgresql://meridian:meridian@localhost:5433/meridian

# Redis (note non-default port 6380 to avoid conflicts)
MERIDIAN_REDIS_URL=redis://localhost:6380/0

# Kalshi API
# kalshi_env: 'demo' (sandbox; no real money) or 'prod' (live).
MERIDIAN_KALSHI_ENV=demo
# Access key string copied from Kalshi account settings.
MERIDIAN_KALSHI_ACCESS_KEY=
# Path to the RSA PKCS#8 private-key PEM file. Never commit this file.
MERIDIAN_KALSHI_PRIVATE_KEY_PATH=~/.config/meridian/kalshi-private-key.pem
# Per-request timeout in seconds.
MERIDIAN_KALSHI_REQUEST_TIMEOUT=10.0
