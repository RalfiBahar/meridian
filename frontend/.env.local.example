# Copy to .env.local and fill in values.

# Backend URL — used server-side for API rewrites (Next.js config)
MERIDIAN_API_URL=http://localhost:8000

# WebSocket URL — used client-side to connect to the EventHub
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional API key (sent as X-API-Key on REST calls and ?api_key= on WS)
NEXT_PUBLIC_API_KEY=
